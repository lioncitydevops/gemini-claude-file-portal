# Copy this file to .env.local and fill in your API keys

# Google AI Studio - https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Anthropic Console - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_claude_api_key_here

# Moonshot Kimi - https://platform.kimi.ai/console/api-keys
MOONSHOT_API_KEY=your_kimi_api_key_here
# Optional overrides (defaults: https://api.moonshot.ai/v1 and kimi-k3)
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=kimi-k3

# Vercel Blob is automatically configured when you add it to your project.
# For local dev without Blob, files are stored in .upload-storage/
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

# Blob access mode must match your store (new Vercel stores are usually private).
BLOB_STORE_ACCESS=private
